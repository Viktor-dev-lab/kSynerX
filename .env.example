# Docker Compose works without .env, using these defaults.
# Copy this file to .env to customize Docker or run Java apps locally.
# Run from the repository root; Maven also uses this directory for all apps.
# Use unquoted values and forward slashes in paths. Restart apps after editing.

# PostgreSQL (Compose and CDMS)
POSTGRES_DB=cdms
POSTGRES_USER=cdms
POSTGRES_PASSWORD=cdms_local_password
POSTGRES_PORT=5433
POSTGRES_HOST=localhost
DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# HTTP ports and shared source identity
CDMS_PORT=8080
INVENTORY_PORT=8081
INVENTORY_SOURCE_CODE=VIETFUL_DEMO
INVENTORY_BASE_URL=http://localhost:${INVENTORY_PORT}
CDMS_WEBHOOK_URL=http://localhost:${CDMS_PORT}/api/v1/webhooks/inventory/products

# Inventory: keep the state file across restarts to preserve source revisions.
INVENTORY_SEED=20261020
INVENTORY_STATE_FILE=inventory-service/.data/inventory-products.json

# Feign
INVENTORY_CONNECT_TIMEOUT_MS=3000
INVENTORY_READ_TIMEOUT_MS=10000

# Webhook testing defaults. Set polling to true to run both mechanisms.
INVENTORY_WEBHOOK_ENABLED=true
INVENTORY_POLLING_ENABLED=false
INVENTORY_POLLING_INITIAL_DELAY_MS=5000
INVENTORY_POLLING_FIXED_DELAY_MS=30000
INVENTORY_POLLING_CORE_POOL_SIZE=2
INVENTORY_POLLING_MAX_POOL_SIZE=4
INVENTORY_POLLING_QUEUE_CAPACITY=10
TASK_EXECUTOR_SHUTDOWN_SECONDS=20

# Inbox worker
INBOX_WORKER_ENABLED=true
INBOX_WORKER_INITIAL_DELAY_MS=1000
INBOX_WORKER_FIXED_DELAY_MS=1000
INBOX_WORKER_CONCURRENCY=2
INBOX_WORKER_BATCH_SIZE=50
INBOX_WORKER_MAX_ATTEMPTS=5
INBOX_WORKER_RETRY_DELAY_SECONDS=10

# Callback client on the host (outside Docker): blank product ID sends all products.
# Blank snapshot paths use the API.
# Capture example: CALLBACK_SAVE_SNAPSHOT_FILE=.data/webhook-before.json
# Replay example: CALLBACK_SNAPSHOT_FILE=.data/webhook-before.json
# Clear the capture path after saving; an existing file is never overwritten.
CALLBACK_PRODUCT_ID=
CALLBACK_SNAPSHOT_FILE=
CALLBACK_SAVE_SNAPSHOT_FILE=
CALLBACK_REPEAT=1
CALLBACK_CONCURRENCY=1
CALLBACK_MAX_ATTEMPTS=3
CALLBACK_RETRY_DELAY_MS=1000
CALLBACK_TIMEOUT_MS=10000

# Docker bind mount (relative to this repository). Inventory reuses local revisions.
# Docker fixes the internal state path; local Maven/JAR uses INVENTORY_STATE_FILE.
DOCKER_INVENTORY_DATA_DIR=./inventory-service/.data
